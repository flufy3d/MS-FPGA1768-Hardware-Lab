# Leave everything else alone
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# --------------------------------------------------------------------------
# Partial reconfiguration (Arria 10, internal host = pr_ip)
#
# Reserved core-only region between I/O column 2 (bank 2A at X=78) and
# I/O column 3 (X=142, DDR4 banks 3B-3G over Y~26-181), leaving room on the
# right for the EMIF core-side logic. Coordinates are a lab choice, not a
# board fact (probe fit of 2026-11-18, see README).
# --------------------------------------------------------------------------
set_global_assignment -name REVISION_TYPE PR_IMPL
set_global_assignment -name GENERATE_PR_RBF_FILE ON
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF

set_instance_assignment -name PARTITION pr_partition -to u_persona
set_instance_assignment -name PARTIAL_RECONFIGURATION_PARTITION ON -to u_persona
set_instance_assignment -name PLACE_REGION "X96 Y72 X127 Y151" -to u_persona
set_instance_assignment -name ROUTE_REGION "X94 Y70 X129 Y153" -to u_persona
set_instance_assignment -name RESERVE_PLACE_REGION ON -to u_persona
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to u_persona
set_instance_assignment -name REGION_NAME pr_region -to u_persona

# Import the static region from the base revision and rebind the persona.
set_instance_assignment -name QDB_FILE_PARTITION output_files/ddr4_static.qdb -to |
set_instance_assignment -name ENTITY_REBINDING persona_prbs -to u_persona

# Platform Designer IP (generated by make_qsys.tcl)
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_clk_100.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pcie.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_temp.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pll_pr.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pr_ip.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pio_counter.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pio_id.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pio_temp.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_pio_persona.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_scratch_ram.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_id_br.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_regs_br.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_persona_br.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_flash_br.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_flash.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_emif_top.ip
set_global_assignment -name IP_FILE ip/shell_sys/shell_sys_emif_bot.ip
