; pcie_bar.inf — KMDF function driver for the lab PCIe endpoints (1172:E003):
; BAR0 access, configuration space reads and DMA common buffers (1.1).
;
; Test-signed only. Do not distribute.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=pcie_bar.cat
DriverVer=11/19/2026,1.1.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
pcie_bar.sys = 1,,

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=PcieBar_Install, PCI\VEN_1172&DEV_E003

[PcieBar_Install.NT]
CopyFiles=@pcie_bar.sys
KmdfService=PCIEBAR, PcieBar_KMDF

[PcieBar_Install.NT.Services]
AddService=PCIEBAR, 0x00000002, PcieBar_Service

[PcieBar_Service]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\pcie_bar.sys

[PcieBar_KMDF]
KmdfLibraryVersion=1.31

[Strings]
ProviderName="MS-FPGA1768 Hardware Lab"
ManufacturerName="MS-FPGA1768 Hardware Lab"
DeviceName="PCIe BAR0 Test Endpoint (1172:E003)"
DiskName="MS-FPGA1768 PCIe BAR driver"
