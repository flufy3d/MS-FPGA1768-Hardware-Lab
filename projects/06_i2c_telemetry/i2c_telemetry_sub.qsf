# -------------------------------------------------------------------------- #
# i2c_telemetry_sub.qsf — Microsoft FPGA 1768 / Catapult v3 "Longs Peak"
#
# PR IMPLEMENTATION revision of i2c_telemetry. It imports the placed and
# routed static region of the base revision (output_files/
# i2c_telemetry_static.qdb, exported by build_pr.ps1) and implements
# persona_sub (SUM = A - B) in the same PR region.
#
# Base revision description, for reference: PCIe #1 endpoint (x8 Gen3, 64-bit BAR0 64 KB, 1172:E003)
# with a BAR0 register block: SHELL_ID / CAPS, counter, ID, die temperature,
# an I2C master for board buses 1 and 2 (open drain, 1.8 V), the PR
# controller and a reconfigurable region (u_persona). The base revision
# implements persona_add (SUM = A + B). No LEDs are used.
#
# Device, pin and PR region settings are a copy of i2c_telemetry.qsf.
# Keep the two in sync. Only the "Partial reconfiguration" block and the
# persona source file differ.
#
# Volatile JTAG configuration only. The configuration flash is not touched.
# -------------------------------------------------------------------------- #

set_global_assignment -name FAMILY "Arria 10"
set_global_assignment -name DEVICE 10AXF40AA
set_global_assignment -name TOP_LEVEL_ENTITY i2c_telemetry
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1.0
set_global_assignment -name LAST_QUARTUS_VERSION "25.1.0 SP0.36 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# Source files
set_global_assignment -name SYSTEMVERILOG_FILE i2c_telemetry.sv
set_global_assignment -name SYSTEMVERILOG_FILE bar0_regs.sv
set_global_assignment -name SYSTEMVERILOG_FILE i2c_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE persona_sub.sv
set_global_assignment -name SDC_FILE i2c_telemetry.sdc

# --------------------------------------------------------------------------
# Configuration scheme (matches the on-board 1 Gb QSPI flash, ASx4)
# NOTE: Quartus 25.1 removed USE_CONFIGURATION_DEVICE from the compile flow.
#       JTAG .sof generation does not need it; ASx4 settings are only relevant
#       when converting to .jic with quartus_cpf.
# --------------------------------------------------------------------------
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"
set_global_assignment -name ACTIVE_SERIAL_CLOCK FREQ_100MHZ
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name ENABLE_OCT_DONE OFF

# --------------------------------------------------------------------------
# Pin assignments — see hardware/pinouts/csv/fpga_3_J1_PCIe1_8x_PCIe_Board.csv
# --------------------------------------------------------------------------

# 100 MHz board oscillator U59 / CLKUSR (AP20)
set_location_assignment PIN_AP20 -to clk_100
set_instance_assignment -name IO_STANDARD "1.8 V" -to clk_100

# The 50 MHz PR controller PLL takes clk_100 from the global clock network:
# AP20 is the CLKUSR pin, not an IOPLL reference clock pin (fitter error
# 18805 without this line, see 04_pcie_hot_update/README.md).
set_instance_assignment -name GLOBAL_SIGNAL GLOBAL_CLOCK -to clk_100

# PCIe #1 reference clock, 100 MHz LVDS from U57/U56 (AN29/AN28)
set_location_assignment PIN_AN29 -to clk_pcie1
set_location_assignment PIN_AN28 -to "clk_pcie1(n)"
set_instance_assignment -name IO_STANDARD LVDS -to clk_pcie1

# PCIe #1 PERST# (AW16)
set_location_assignment PIN_AW16 -to pcie1_perstn
set_instance_assignment -name IO_STANDARD "1.8 V" -to pcie1_perstn

# PCIe #1 receive lanes 0-7
set_location_assignment PIN_AN33 -to pcie1_rx[0]
set_location_assignment PIN_AN32 -to "pcie1_rx[0](n)"
set_location_assignment PIN_AM31 -to pcie1_rx[1]
set_location_assignment PIN_AM30 -to "pcie1_rx[1](n)"
set_location_assignment PIN_AM35 -to pcie1_rx[2]
set_location_assignment PIN_AM34 -to "pcie1_rx[2](n)"
set_location_assignment PIN_AL33 -to pcie1_rx[3]
set_location_assignment PIN_AL32 -to "pcie1_rx[3](n)"
set_location_assignment PIN_AK31 -to pcie1_rx[4]
set_location_assignment PIN_AK30 -to "pcie1_rx[4](n)"
set_location_assignment PIN_AK35 -to pcie1_rx[5]
set_location_assignment PIN_AK34 -to "pcie1_rx[5](n)"
set_location_assignment PIN_AJ33 -to pcie1_rx[6]
set_location_assignment PIN_AJ32 -to "pcie1_rx[6](n)"
set_location_assignment PIN_AH31 -to pcie1_rx[7]
set_location_assignment PIN_AH30 -to "pcie1_rx[7](n)"

# PCIe #1 transmit lanes 0-7
set_location_assignment PIN_AU37 -to pcie1_tx[0]
set_location_assignment PIN_AU36 -to "pcie1_tx[0](n)"
set_location_assignment PIN_AT35 -to pcie1_tx[1]
set_location_assignment PIN_AT34 -to "pcie1_tx[1](n)"
set_location_assignment PIN_AT39 -to pcie1_tx[2]
set_location_assignment PIN_AT38 -to "pcie1_tx[2](n)"
set_location_assignment PIN_AR37 -to pcie1_tx[3]
set_location_assignment PIN_AR36 -to "pcie1_tx[3](n)"
set_location_assignment PIN_AP35 -to pcie1_tx[4]
set_location_assignment PIN_AP34 -to "pcie1_tx[4](n)"
set_location_assignment PIN_AP39 -to pcie1_tx[5]
set_location_assignment PIN_AP38 -to "pcie1_tx[5](n)"
set_location_assignment PIN_AN37 -to pcie1_tx[6]
set_location_assignment PIN_AN36 -to "pcie1_tx[6](n)"
set_location_assignment PIN_AM39 -to pcie1_tx[7]
set_location_assignment PIN_AM38 -to "pcie1_tx[7](n)"

# Transceiver I/O standards
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[0]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[1]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[2]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[3]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[4]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[5]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[6]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_rx[7]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[0]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[1]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[2]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[3]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[4]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[5]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[6]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to pcie1_tx[7]

# --------------------------------------------------------------------------
# I2C buses — see hardware/pinouts/csv/fpga_8_I2C.csv and docs/hardware/i2c.md
# Open drain: the RTL only drives 0 or releases the pin (high-Z). The pull-ups
# are on the board; no internal pull-up is enabled.
# --------------------------------------------------------------------------

# Bus 1 (retimer U17 0x22, QSFP cage 0x50, header J10)
set_location_assignment PIN_L20 -to i2c1_sda
set_location_assignment PIN_K20 -to i2c1_scl
set_instance_assignment -name IO_STANDARD "1.8 V" -to i2c1_sda
set_instance_assignment -name IO_STANDARD "1.8 V" -to i2c1_scl

# Bus 2 (MP2953B 0x40, LM25066 0x42, TMP411 0x4C, M24128 0x51, ..., header J2)
set_location_assignment PIN_K21 -to i2c2_sda
set_location_assignment PIN_J23 -to i2c2_scl
set_instance_assignment -name IO_STANDARD "1.8 V" -to i2c2_sda
set_instance_assignment -name IO_STANDARD "1.8 V" -to i2c2_scl

# Drive only matters for pulling a line low (open drain). 8 mA and slow slew,
# as for the LEDs of project 05; I2C edges are set by the pull-ups.
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to i2c1_sda
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to i2c1_scl
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to i2c2_sda
set_instance_assignment -name CURRENT_STRENGTH_NEW 8MA -to i2c2_scl
set_instance_assignment -name SLEW_RATE 0 -to i2c1_sda
set_instance_assignment -name SLEW_RATE 0 -to i2c1_scl
set_instance_assignment -name SLEW_RATE 0 -to i2c2_sda
set_instance_assignment -name SLEW_RATE 0 -to i2c2_scl

# --------------------------------------------------------------------------
# Partial reconfiguration (Arria 10, internal host = pr_ip in the Qsys system)
# Same region as 04_pcie_hot_update: a reserved, core-only LogicLock region
# away from the PCIe hard IP (a lab choice, not a board fact).
# Plain PR data (no compression, no encryption) to match pr_ip CDRATIO = 1.
# --------------------------------------------------------------------------
set_global_assignment -name REVISION_TYPE PR_IMPL
set_global_assignment -name GENERATE_PR_RBF_FILE ON
set_instance_assignment -name PARTITION pr_partition -to u_persona
set_instance_assignment -name PARTIAL_RECONFIGURATION_PARTITION ON -to u_persona
set_instance_assignment -name PLACE_REGION "X120 Y120 X139 Y139" -to u_persona
set_instance_assignment -name ROUTE_REGION "X118 Y118 X141 Y141" -to u_persona
set_instance_assignment -name RESERVE_PLACE_REGION ON -to u_persona
set_instance_assignment -name CORE_ONLY_PLACE_REGION ON -to u_persona
set_instance_assignment -name REGION_NAME pr_region -to u_persona

# Import the static region from the base revision and rebind the persona.
set_instance_assignment -name QDB_FILE_PARTITION output_files/i2c_telemetry_static.qdb -to |
set_instance_assignment -name ENTITY_REBINDING persona_sub -to u_persona

# Leave everything else alone
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_clk_100.ip
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_pcie.ip
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_temp.ip
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_regs_br.ip
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_scratch_ram.ip
set_global_assignment -name QSYS_FILE i2c_sys.qsys
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_pll_pr.ip
set_global_assignment -name IP_FILE ip/i2c_sys/i2c_sys_pr_ip.ip
